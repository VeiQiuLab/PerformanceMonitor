<Window x:Class="PerformanceMonitor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:PerformanceMonitor.ViewModels"
        Title="Performance Monitor"
        Width="1180" Height="760" MinWidth="860" MinHeight="560"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource PrimaryTextBrush}"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded" Closing="OnClosing">
    <Window.Resources>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="28,22,28,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Performance Monitor" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="Local and LAN devices" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="Settings" Click="OnSettingsClick" VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Devices}" Margin="18,0,18,18" Foreground="{StaticResource PrimaryTextBrush}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewModels:DeviceViewModel}">
                        <Border Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="1" CornerRadius="10" Margin="10" Padding="20">
                            <StackPanel>
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ComputerText}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Ellipse Width="8" Height="8" Margin="0,1,7,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource OfflineBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource OnlineBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding LastUpdatedText}" Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>

                                <Border BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,12">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="CPU" Style="{StaticResource SectionTitle}" />
                                            <TextBlock Grid.Column="1" Text="{Binding CpuTemperatureText}" Margin="12,0" Style="{StaticResource MetricValue}" />
                                            <TextBlock Grid.Column="2" Text="{Binding CpuPowerText}" Style="{StaticResource MetricValue}" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
                                            <ProgressBar Value="{Binding CpuUsageValue, Mode=OneWay}" Margin="0,5,12,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding CpuUsageText}" Style="{StaticResource MetricValue}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,12">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding GpuNameText}" Style="{StaticResource SectionTitle}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding GpuTemperatureText}" Style="{StaticResource MetricValue}" Margin="12,0,0,0" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
                                            <ProgressBar Value="{Binding GpuUsageValue, Mode=OneWay}" Margin="0,5,12,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding GpuUsageText}" Style="{StaticResource MetricValue}" />
                                        </Grid>
                                        <Grid Margin="0,8,0,0">
                                            <TextBlock Text="VRAM" Style="{StaticResource MetricLabel}" />
                                            <TextBlock Text="{Binding VramText}" Style="{StaticResource MetricValue}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,12">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="RAM" Style="{StaticResource SectionTitle}" />
                                            <TextBlock Grid.Column="1" Text="{Binding MemoryText}" Style="{StaticResource MetricValue}" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
                                            <ProgressBar Value="{Binding MemoryUsageValue, Mode=OneWay}" Margin="0,5,12,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding MemoryUsageText}" Style="{StaticResource MetricValue}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,14,0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="DISK" Style="{StaticResource MetricLabel}" />
                                        <TextBlock Text="{Binding DiskActiveText}" Margin="0,5,0,0" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding DiskReadText, StringFormat=Read {0}}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding DiskWriteText, StringFormat=Write {0}}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="NETWORK" Style="{StaticResource MetricLabel}" />
                                        <TextBlock Text="{Binding DownloadText, StringFormat=↓ {0}}" Margin="0,5,0,0" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding UploadText, StringFormat=↑ {0}}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Visibility="{Binding FanVisibility}">
                                        <TextBlock Text="FAN" Style="{StaticResource MetricLabel}" />
                                        <TextBlock Text="{Binding FanText}" Margin="0,5,0,0" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Text="{Binding ServiceMessage}" Foreground="{StaticResource SecondaryTextBrush}"
                   Margin="28,0,28,16" FontSize="12" />
    </Grid>
</Window>
